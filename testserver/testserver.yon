{
  "version": 1,
  "name": "Yon Test Server",
  "auth": {
    "kind": "bearer",
    "token": "yon-demo-token"
  },
  "variables": [
    {
      "key": "baseUrl",
      "value": "http://localhost:7878",
      "enabled": true
    },
    {
      "key": "bearerToken",
      "value": "yon-demo-token",
      "enabled": true
    }
  ],
  "activeEnvironment": "Local",
  "requests": [
    {
      "name": "GET — query params + custom header",
      "method": "GET",
      "url": "{{baseUrl}}/get",
      "params": [
        {
          "key": "page",
          "value": "1",
          "enabled": true
        },
        {
          "key": "q",
          "value": "hello",
          "enabled": true
        },
        {
          "key": "debug",
          "value": "true",
          "enabled": true
        }
      ],
      "headers": [
        {
          "key": "X-Demo",
          "value": "yon",
          "enabled": true
        }
      ],
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      }
    },
    {
      "name": "POST — JSON body",
      "method": "POST",
      "url": "{{baseUrl}}/post",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "json",
        "content": "{\n  \"hello\": \"yon\",\n  \"n\": 42,\n  \"tags\": [\"http\", \"offline\"]\n}"
      }
    },
    {
      "name": "PUT — JSON body",
      "method": "PUT",
      "url": "{{baseUrl}}/put",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "json",
        "content": "{ \"id\": 7, \"name\": \"updated\" }"
      }
    },
    {
      "name": "DELETE",
      "method": "DELETE",
      "url": "{{baseUrl}}/delete",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      }
    },
    {
      "name": "Bearer auth (inherits collection token)",
      "method": "GET",
      "url": "{{baseUrl}}/bearer",
      "auth": {
        "kind": "inherit"
      },
      "body": {
        "type": "none"
      }
    },
    {
      "name": "Basic auth (overrides collection)",
      "method": "GET",
      "url": "{{baseUrl}}/basic-auth/alice/secret",
      "auth": {
        "kind": "basic",
        "username": "alice",
        "password": "secret"
      },
      "body": {
        "type": "none"
      }
    },
    {
      "name": "Headers echo",
      "method": "GET",
      "url": "{{baseUrl}}/headers",
      "headers": [
        {
          "key": "X-Trace-Id",
          "value": "abc-123",
          "enabled": true
        },
        {
          "key": "Accept",
          "value": "application/json",
          "enabled": true
        }
      ],
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      }
    },
    {
      "name": "Status 404 (orange)",
      "method": "GET",
      "url": "{{baseUrl}}/status/404",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      }
    },
    {
      "name": "Status 500 (red)",
      "method": "GET",
      "url": "{{baseUrl}}/status/500",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      }
    },
    {
      "name": "Redirect → /get (follows)",
      "method": "GET",
      "url": "{{baseUrl}}/redirect",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      }
    },
    {
      "name": "Large body (\u003e 256 KB, truncates)",
      "method": "GET",
      "url": "{{baseUrl}}/large",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      }
    },
    {
      "name": "Slow 10s (test Cancel / timeout)",
      "method": "GET",
      "url": "{{baseUrl}}/slow",
      "params": [
        {
          "key": "seconds",
          "value": "10",
          "enabled": true
        }
      ],
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      }
    },
    {
      "name": "Pretty JSON (syntax colour)",
      "method": "GET",
      "url": "{{baseUrl}}/json",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      }
    },
    {
      "name": "GET — XML response",
      "method": "GET",
      "url": "{{baseUrl}}/xml",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      }
    },
    {
      "name": "POST — XML body",
      "method": "POST",
      "url": "{{baseUrl}}/xml",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "xml",
        "content": "\u003corder id=\"1001\"\u003e\u003citem sku=\"A1\"\u003eWidget\u003c/item\u003e\u003citem sku=\"B2\"\u003eGadget\u003c/item\u003e\u003c/order\u003e"
      }
    },
    {
      "name": "GET — HTML page",
      "method": "GET",
      "url": "{{baseUrl}}/html",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      }
    },
    {
      "name": "GET — SOAP envelope",
      "method": "GET",
      "url": "{{baseUrl}}/soap",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "none"
      }
    },
    {
      "name": "PATCH — echo method",
      "method": "PATCH",
      "url": "{{baseUrl}}/anything",
      "auth": {
        "kind": "none"
      },
      "body": {
        "type": "json",
        "content": "{\n  \"op\": \"replace\",\n  \"value\": 7\n}"
      }
    }
  ]
}
